# ==============================================================================
# VOX Studio — Environment Configuration (Example)
# Copy this file to '.env' for local configuration.
# ==============================================================================

# Application Workspace & Cache Directory (Default: %APPDATA%\.vox_studio)
# VOX_HOME=C:\Users\username\.vox_studio

# Execution Provider for ONNX Runtime (CPU, DirectML, CUDA)
# VOX_ONNX_PROVIDER=CPU

# Default Recording Audio Driver (WASAPI, DirectSound, MME, ASIO)
# VOX_AUDIO_HOST_API=WASAPI

# Default Sample Rate (Default: 48000)
# VOX_SAMPLE_RATE=48000

# Default Bit Depth (16, 24, 32)
# VOX_BIT_DEPTH=24

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# VOX_LOG_LEVEL=INFO

# Headless / Test Mode Flag
# QT_QPA_PLATFORM=offscreen
